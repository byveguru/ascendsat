# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
.vercel
.env

# Firebase Admin SDK service-account keys (used by one-off scripts/*.js and
# seed-test-accounts.js) — grants full unrestricted backend access, never commit
service-account.json
*serviceAccount*.json
*firebase-adminsdk*.json

# Real user PII exports (e.g. export-real-user-emails.js's output) — never commit
*.csv
