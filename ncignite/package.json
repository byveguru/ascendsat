    "test:clean": "node tests/cleanup.mjs",
    "test:delete": "node tests/delete.mjs",
    "test:countdown": "TZ=America/New_York node tests/countdown.mjs",
    "test:checkin": "node tests/checkin-rules.mjs",
    "test:checkin-flow": "node tests/checkin-flow.mjs"
  }
