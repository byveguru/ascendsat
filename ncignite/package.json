{
  "name": "ncignyte",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:pages": "playwright test tests/pages.spec.js",
